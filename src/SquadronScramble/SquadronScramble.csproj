<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>SquadronScramble</AssemblyName>
    <RootNamespace>SquadronScramble</RootNamespace>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.0.0</Version>
    <Product>Squadron Scramble</Product>
  </PropertyGroup>
  <ItemGroup>
    <!-- MonoGame and the game load types by reflection (content readers, XmlSerializer):
         keep them whole if the build is trimmed (PublishTrimmed=true). -->
    <TrimmerRootAssembly Include="MonoGame.Framework" />
    <TrimmerRootAssembly Include="SquadronScramble" />
    <TrimmerRootAssembly Include="mscorlib" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pre-converted (PC) XNB content, see tools/XboxContentConverter -->
    <None Include="Content\**\*.xnb" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Icon.bmp" LogicalName="Icon.bmp" Condition="Exists('Icon.bmp')" />
  </ItemGroup>
</Project>
